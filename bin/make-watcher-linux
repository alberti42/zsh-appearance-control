#!/usr/bin/env zsh

emulate -LR zsh -o warn_create_global -o no_short_loops
setopt errexit nounset pipefail

# Build the Linux appearance watcher release artifact.
#
# Produces dist/zac-watch-linux-<tag>.zip containing:
#   zac-watch-linux                 the watcher script (mode 755)
#   zac-watch-linux.service.in      systemd user unit template
#   zac-watch-linux.desktop.in      XDG autostart template (for sessions that
#                                   are not integrated with systemd --user)
#   README.md                       install instructions
#
# Nothing is compiled: this is a zsh script, so the artifact is portable across
# distributions and architectures. It is zipped rather than attached as a plain
# file because a release asset carries no mode bits — a bare script downloads
# without the execute bit — and because the unit template belongs with it.
#
# Runs anywhere (no Linux host needed to package it).

function _usage() {
  print -r -- "usage: $1 <version-tag>" >&2
  print -r -- "example: $1 v0.1.0" >&2
}

local version=${1:-}
if [[ -z $version ]]; then
  _usage "${0:t}"
  exit 2
fi

local repo_root
repo_root=$(command git rev-parse --show-toplevel 2>/dev/null) || {
  print -r -- "${0:t}: must run inside a git repository" >&2
  exit 1
}

cd "$repo_root"

local pkg_dir=watchers/linux
local out_dir=dist
command mkdir -p -- "$out_dir"

local script="$pkg_dir/zac-watch-linux"
local unit="$pkg_dir/systemd/zac-watch-linux.service.in"
local desktop="$pkg_dir/autostart/zac-watch-linux.desktop.in"
local readme="$pkg_dir/README.md"

local f
for f in $script $unit $desktop $readme; do
  [[ -f $f ]] || { print -r -- "${0:t}: missing file: $f" >&2; exit 1 }
done

# A syntax error here would ship a watcher that cannot start, and there is no
# compiler to catch it.
command zsh -n "$script" || {
  print -r -- "${0:t}: $script does not parse" >&2
  exit 1
}

local package_dir="zac-watch-linux-${version}"
local zip_path="$out_dir/${package_dir}.zip"

local tmp
tmp=$(command mktemp -d 2>/dev/null || command mktemp -d -t zac-watcher-linux)
trap 'command rm -rf -- "$tmp" 2>/dev/null || true' EXIT

local stage="$tmp/$package_dir"
command mkdir -p -- "$stage"
command cp -- "$script" "$stage/zac-watch-linux"
command cp -- "$unit" "$stage/${unit:t}"
command cp -- "$desktop" "$stage/${desktop:t}"
command cp -- "$readme" "$stage/README.md"
# BSD chmod does not accept `--` after the mode.
command chmod 755 "$stage/zac-watch-linux"

command rm -f -- "$zip_path" 2>/dev/null || true
(cd "$tmp" && zip -qr "$repo_root/$zip_path" "$package_dir")

print -r -- "$zip_path"
